{
  "api_backend": {
    "type": "string",
    "title": "出图接口来源",
    "default": "novelai",
    "description": "默认novelai，用完切newapi",
    "options": [
      "novelai",
      "newapi"
    ],
    "option_names": [
      "NovelAI 官方 API",
      "new-api"
    ]
  },
  "enable_v5": {
    "type": "bool",
    "title": "启用 V5 画图",
    "default": true,
    "description": "关闭后只用V4.5出图"
  },
  "group_daily_image_limit": {
    "type": "int",
    "title": "每群每日免费张数",
    "default": 5,
    "minimum": 0,
    "description": "每群每天免费张数，0为关闭"
  },
  "api_token": {
    "type": "string",
    "title": "NovelAI Token",
    "default": "",
    "description": "免费额度用的NovelAI密钥"
  },
  "account_tokens": {
    "type": "template_list",
    "title": "多账户额度",
    "default": [],
    "description": "额外账户，仅用于查额度",
    "templates": {
      "account": {
        "name": "NovelAI 账户",
        "display_item": "name",
        "hint": "不同账户用不同备注名",
        "items": {
          "name": {
            "description": "账户备注",
            "type": "string",
            "default": "",
            "hint": "仅用于区分账户"
          },
          "api_token": {
            "description": "NovelAI Token",
            "type": "string",
            "default": "",
            "hint": "以pst-开头的持久Token"
          },
          "enable": {
            "description": "启用此账户",
            "type": "bool",
            "default": true
          }
        }
      }
    }
  },
  "newapi_base_url": {
    "type": "string",
    "title": "new-api 地址",
    "default": "http://localhost:3000",
    "description": "new-api根地址，别带子路径"
  },
  "newapi_api_key": {
    "type": "string",
    "title": "new-api API Key",
    "default": "",
    "description": "仅newapi后端出图用"
  },
  "default_model": {
    "type": "string",
    "title": "默认模型",
    "default": "nai-diffusion-5-full",
    "description": "新会话默认模型，可改",
    "options": [
      "nai-diffusion-5-full",
      "nai-diffusion-5-curated",
      "nai-diffusion-4-5-full",
      "nai-diffusion-4-5-curated"
    ],
    "option_names": [
      "V5 Full",
      "V5 Curated",
      "V4.5 Full",
      "V4.5 Curated"
    ]
  },
  "default_resolution": {
    "type": "string",
    "title": "默认分辨率",
    "default": "832x1216",
    "description": "新会话默认，聊天可改",
    "options": [
      "832x1216",
      "1216x832",
      "1024x1024"
    ],
    "option_names": [
      "832x1216（长图）",
      "1216x832（宽图）",
      "1024x1024（方图）"
    ]
  },
  "default_steps": {
    "type": "int",
    "title": "画图步数（1-50）",
    "default": 28,
    "description": "所有用户统一，不能改"
  },
  "default_scale": {
    "type": "float",
    "title": "提示词权重（1-15）",
    "default": 6.5,
    "minimum": 1.0,
    "maximum": 15.0,
    "multipleOf": 0.1,
    "description": "新会话默认，聊天可改"
  },
  "prompt_guidance_rescale": {
    "type": "float",
    "title": "V4.5 引导缩放",
    "default": 0.0,
    "minimum": 0.0,
    "maximum": 1.0,
    "multipleOf": 0.05,
    "description": "仅V4.5生效，聊天可改"
  },
  "default_sampler": {
    "type": "string",
    "title": "默认采样器",
    "default": "k_euler_ancestral",
    "description": "新会话默认，聊天可改",
    "options": [
      "k_euler",
      "k_euler_ancestral",
      "k_dpmpp_2s_ancestral",
      "k_dpmpp_sde",
      "k_dpmpp_2m",
      "k_dpmpp_2m_sde",
      "k_dpmpp_3m_sde"
    ],
    "option_names": [
      "Euler",
      "Euler Ancestral",
      "DPM++ 2S Ancestral",
      "DPM++ SDE",
      "DPM++ 2M",
      "DPM++ 2M SDE",
      "DPM++ 3M SDE"
    ]
  },
  "v4_5_noise_schedule": {
    "type": "string",
    "title": "V4.5 噪声调度",
    "default": "karras",
    "description": "仅V4.5生效",
    "options": [
      "karras",
      "exponential",
      "polyexponential"
    ],
    "option_names": [
      "Karras",
      "Exponential",
      "Polyexponential"
    ]
  },
  "v4_5_variety_boost": {
    "type": "bool",
    "title": "V4.5 多样性增强",
    "default": false,
    "description": "仅V4.5生效，画面更多变"
  },
  "v4_5_decrisper": {
    "type": "bool",
    "title": "V4.5 画质修复",
    "default": false,
    "description": "仅V4.5，减轻过饱和杂色"
  },
  "v4_5_auto_smea": {
    "type": "bool",
    "title": "V4.5 自动防糊",
    "default": false,
    "description": "仅V4.5，大图自动启用"
  },
  "v4_5_smea": {
    "type": "bool",
    "title": "V4.5 手动防糊",
    "default": false,
    "description": "仅V4.5，关自动后手动开"
  },
  "v4_5_smea_dyn": {
    "type": "bool",
    "title": "V4.5 强力防糊",
    "default": false,
    "description": "仅V4.5，开后会启用SMEA"
  },
  "img2img_strength": {
    "type": "float",
    "title": "图生图强度",
    "description": "越低越像原图（0.1-0.9）",
    "default": 0.5,
    "minimum": 0.1,
    "maximum": 0.9,
    "multipleOf": 0.1
  },
  "img2img_noise": {
    "type": "float",
    "title": "图生图噪声",
    "description": "越高变化越大（0.0-1.0）",
    "default": 0.2,
    "minimum": 0.0,
    "maximum": 1.0,
    "multipleOf": 0.1
  },
  "roll_image_count": {
    "type": "int",
    "title": "Roll图张数（1-50）",
    "default": 5,
    "minimum": 1,
    "maximum": 50,
    "description": "新会话默认，聊天可改"
  },
  "admin_users": {
    "type": "string",
    "title": "管理员列表",
    "default": "",
    "description": "管理员QQ号，逗号分隔"
  },
  "whitelist_enabled": {
    "type": "bool",
    "title": "启用白名单",
    "default": false,
    "description": "只让白名单用户使用"
  },
  "whitelist_users": {
    "type": "string",
    "title": "白名单用户",
    "default": "",
    "description": "白名单QQ号，逗号分隔"
  },
  "admin_only_commands": {
    "type": "string",
    "default": "",
    "title": "仅管理员命令",
    "description": "只有管理员能用，逗号分隔"
  },
  "enable_image_audit": {
    "type": "bool",
    "title": "百度图片审核",
    "default": false,
    "description": "开启后图片先过百度审核"
  },
  "enable_auto_save": {
    "type": "bool",
    "title": "自动保存图片",
    "default": false,
    "description": "出图后自动存到本地"
  },
  "enable_auto_recall": {
    "type": "bool",
    "title": "自动撤回",
    "default": false,
    "description": "出图后自动撤回消息"
  },
  "auto_recall_delay": {
    "type": "int",
    "title": "自动撤回时间",
    "default": 30,
    "minimum": 1,
    "maximum": 120,
    "description": "发出多少秒后撤回"
  },
  "show_params": {
    "type": "bool",
    "title": "显示生成参数",
    "default": true,
    "description": "出图后附上参数信息"
  },
  "save_path": {
    "type": "string",
    "title": "保存路径",
    "default": "novelai_images",
    "description": "自动保存图片的文件夹"
  },
  "roll_log_level": {
    "type": "int",
    "title": "Roll图日志等级",
    "default": 3,
    "minimum": 1,
    "maximum": 5,
    "enum": [
      1,
      2,
      3,
      4,
      5
    ],
    "enumNames": [
      "1-静默",
      "2-简洁",
      "3-标准",
      "4-详细",
      "5-调试"
    ],
    "description": "数值越大日志越详细"
  },
  "draw_log_level": {
    "type": "int",
    "title": "画图日志等级",
    "default": 3,
    "minimum": 1,
    "maximum": 5,
    "enum": [
      1,
      2,
      3,
      4,
      5
    ],
    "enumNames": [
      "1-静默",
      "2-简洁",
      "3-标准",
      "4-详细",
      "5-调试"
    ],
    "description": "数值越大日志越详细"
  },
  "baidu_audit_api_key": {
    "type": "string",
    "title": "百度审核API Key",
    "default": "",
    "description": "百度智能云创建的Key"
  },
  "baidu_audit_secret_key": {
    "type": "string",
    "title": "百度审核Secret Key",
    "default": "",
    "description": "与 API Key 配套使用"
  },
  "audit_failed_save_path": {
    "type": "string",
    "title": "审核失败图片保存路径",
    "default": "audit_failed",
    "description": "审核没过的图片存这里"
  },
  "audit_conclusion_type": {
    "type": "int",
    "title": "审核严格程度",
    "default": 2,
    "minimum": 1,
    "maximum": 3,
    "description": "1=严格，2=中等，3=宽松"
  },
  "audit_strategy_id": {
    "type": "string",
    "title": "审核策略ID",
    "default": "",
    "description": "留空用百度默认策略"
  },
  "audit_whitelist_groups": {
    "type": "list",
    "title": "免审核的群白名单",
    "default": [],
    "description": "这些群发图不送审核"
  },
  "audit_whitelist_bots": {
    "type": "list",
    "title": "审核哪些机器人",
    "default": [],
    "description": "留空则不审核任何机器人"
  },
  "presets": {
    "type": "string",
    "default": "{}",
    "description": "提示词预设(JSON格式)",
    "invisible": true
  },
  "style_presets": {
    "type": "string",
    "default": "{}",
    "description": "画风库数据，由插件 WebUI 管理",
    "invisible": true
  },
  "preset_categories": {
    "type": "string",
    "default": "{}",
    "description": "预设分类(JSON格式)",
    "invisible": true
  },
  "enable_style_preset": {
    "type": "bool",
    "title": "默认启用画风",
    "default": false,
    "description": "新会话默认开画风"
  },
  "selected_style_preset": {
    "type": "string",
    "title": "默认画风名称",
    "default": "",
    "description": "新会话默认用的画风"
  },
  "cooldown_seconds": {
    "type": "int",
    "title": "冷却时间(秒)",
    "default": 10,
    "minimum": 0,
    "maximum": 300,
    "description": "同一用户两次间隔"
  },
  "request_interval": {
    "type": "int",
    "title": "请求间隔(秒)",
    "default": 3,
    "minimum": 1,
    "maximum": 60,
    "description": "两次请求最小间隔"
  },
  "enable_request_retry": {
    "type": "bool",
    "title": "失败自动重试",
    "default": true,
    "description": "出图失败时自动重试"
  },
  "request_retry_count": {
    "type": "int",
    "title": "请求重试次数",
    "default": 5,
    "minimum": 0,
    "maximum": 5,
    "description": "失败后最多重试几次，0为不重试"
  },
  "request_retry_max_delay": {
    "type": "float",
    "title": "重试最大等待(秒)",
    "default": 10.0,
    "minimum": 0.0,
    "maximum": 60.0,
    "multipleOf": 0.5,
    "description": "两次重试最长等待时间"
  },
  "image_proxy": {
    "type": "string",
    "title": "图片代理",
    "default": "",
    "description": "下载图片用的代理"
  },
  "api_proxy": {
    "type": "string",
    "title": "API反向代理地址",
    "default": "",
    "description": "替换请求域名，不是网络代理"
  },
  "novelai_proxy": {
    "type": "string",
    "title": "画图HTTP代理",
    "default": "",
    "description": "画图请求的网络代理"
  }
}
